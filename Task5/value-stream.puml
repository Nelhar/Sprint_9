rectangle "3.3 Рекомендации\nBuild (6–12 мес.)" as C33 #D4EDDA
rectangle "1.3 Цены и промо\nBuild (MVP)" as C13 #D4EDDA
H2 -right[dotted]- C31
C31 -right[hidden]- C12
C12 -right[hidden]- C32
C32 -right[hidden]- C33
C33 -right[hidden]- C13

rectangle "4.1 Корзина и оформление\nBuild (MVP)" as C41 #D4EDDA
rectangle "4.2 Приём платежей\nPartner + маршрутизация Build (MVP)" as C42 #FFF4CC
rectangle "4.3 Флеш-распродажи\nBuild (MVP)" as C43 #D4EDDA
H3 -right[dotted]- C41
C41 -right[hidden]- C42
C42 -right[hidden]- C43

rectangle "8.3 WhatsApp для продавцов\nPartner (MVP)" as C83 #FFF4CC
rectangle "5.1 Передача отправок\nPartner + ACL (MVP)" as C51 #FFF4CC
