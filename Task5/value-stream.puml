@startuml value-stream
skinparam defaultFontName Arial
skinparam shadowing false
skinparam rectangle {
  RoundCorner 6
  BorderColor #666666
}
skinparam ArrowColor #1168BD
skinparam ArrowThickness 2
skinparam nodesep 25
skinparam ranksep 30
